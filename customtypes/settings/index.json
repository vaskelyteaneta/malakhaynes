{
  "format": "custom",
  "id": "settings",
  "label": "Settings",
  "repeatable": false,
  "status": true,
  "json": {
    "Main": {
      "homepage": {
        "type": "Link",
        "config": {
          "label": "Home page (which page visitors land on at the site root)",
          "placeholder": "Pick a page",
          "select": "document",
          "customtypes": [
            "page"
          ],
          "allowTargetBlank": false,
          "repeat": false
        }
      },
      "logo": {
        "type": "Image",
        "config": {
          "label": "Logo",
          "constraint": {},
          "thumbnails": []
        }
      },
      "play_icon": {
        "type": "Image",
        "config": {
          "label": "Play button (optional — upload a PNG with a transparent background; leave empty for the default triangle)",
          "constraint": {},
          "thumbnails": []
        }
      },
      "footer_text": {
        "type": "StructuredText",
        "config": {
          "label": "Footer text (optional)",
          "placeholder": "",
          "allowTargetBlank": false,
          "multi": "paragraph,strong,em"
        }
      },
      "footer_links": {
        "type": "Group",
        "config": {
          "label": "footer_links",
          "repeat": true,
          "fields": {
            "label": {
              "type": "Text",
              "config": {
                "label": "label",
                "placeholder": "e.g. Instagram"
              }
            },
            "link": {
              "type": "Link",
              "config": {
                "label": "link",
                "placeholder": "",
                "select": null,
                "allowTargetBlank": true,
                "allowText": true,
                "repeat": false
              }
            }
          }
        }
      },
      "navigation": {
        "type": "Group",
        "config": {
          "label": "navigation",
          "repeat": true,
          "fields": {
            "label": {
              "type": "Text",
              "config": {
                "label": "label",
                "placeholder": ""
              }
            },
            "link": {
              "type": "Link",
              "config": {
                "label": "link",
                "placeholder": "",
                "select": null,
                "allowTargetBlank": true,
                "allowText": true,
                "repeat": false
              }
            }
          }
        }
      },
      "slices": {
        "type": "Slices",
        "fieldset": "Slice Zone"
      }
    },
    "Intro": {
      "intro_video": {
        "type": "Link",
        "config": {
          "label": "Intro video (.mp4 upload) — optional",
          "placeholder": "Upload or select an mp4",
          "select": "media"
        }
      },
      "intro_video_url": {
        "type": "Text",
        "config": {
          "label": "Intro video URL — optional; a direct link to an .mp4 file, if you host it elsewhere. Overrides the upload above.",
          "placeholder": "https://…/intro.mp4"
        }
      },
      "intro_image": {
        "type": "Image",
        "config": {
          "label": "Intro image — optional; shown if no video is set. If you don't upload anything, it's just going to be text",
          "constraint": {},
          "thumbnails": []
        }
      }
    }
  }
}
