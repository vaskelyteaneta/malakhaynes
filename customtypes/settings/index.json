{
  "format": "custom",
  "id": "settings",
  "label": "Settings",
  "repeatable": false,
  "status": true,
  "json": {
    "Main": {
      "logo": {
        "type": "Image",
        "config": {
          "label": "Logo",
          "constraint": {},
          "thumbnails": []
        }
      },
      "footer_text": {
        "type": "StructuredText",
        "config": {
          "label": "Footer text (optional)",
          "placeholder": "",
          "allowTargetBlank": false,
          "multi": "paragraph,strong,em"
        }
      },
      "footer_links": {
        "type": "Group",
        "config": {
          "label": "footer_links",
          "repeat": true,
          "fields": {
            "label": {
              "type": "Text",
              "config": {
                "label": "label",
                "placeholder": "e.g. Instagram"
              }
            },
            "link": {
              "type": "Link",
              "config": {
                "label": "link",
                "placeholder": "",
                "select": null,
                "allowTargetBlank": true,
                "allowText": true,
                "repeat": false
              }
            }
          }
        }
      },
      "navigation": {
        "type": "Group",
        "config": {
          "label": "navigation",
          "repeat": true,
          "fields": {
            "label": {
              "type": "Text",
              "config": {
                "label": "label",
                "placeholder": ""
              }
            },
            "link": {
              "type": "Link",
              "config": {
                "label": "link",
                "placeholder": "",
                "select": null,
                "allowTargetBlank": true,
                "allowText": true,
                "repeat": false
              }
            }
          }
        }
      },
      "slices": {
        "type": "Slices",
        "fieldset": "Slice Zone"
      }
    },
    "Intro": {
      "intro_video": {
        "type": "Link",
        "config": {
          "label": "Intro video (.mp4 upload) — leave empty to disable the intro splash entirely",
          "placeholder": "Upload or select an mp4",
          "select": "media"
        }
      },
      "intro_video_url": {
        "type": "Text",
        "config": {
          "label": "Intro video URL (.m3u8 HLS or .mp4) — paste an external link; overrides the uploaded file above",
          "placeholder": "https://…/playlist.m3u8"
        }
      },
      "intro_frequency": {
        "type": "Select",
        "config": {
          "label": "Intro plays",
          "placeholder": "",
          "options": ["Once per session", "Every visit"],
          "default_value": "Once per session"
        }
      }
    }
  }
}
