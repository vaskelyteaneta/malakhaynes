{
  "id": "media_grid",
  "type": "SharedSlice",
  "name": "MediaGrid",
  "description": "Reusable grid OR slider of media items (video / image / embed / text), each with a caption, size and optional link.",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Default",
      "imageUrl": "",
      "primary": {
        "shared_caption": {
          "type": "StructuredText",
          "config": {
            "label": "Shared caption (optional \u2014 used when every item shares the same caption, instead of filling in each item's own Caption field)",
            "placeholder": "",
            "allowTargetBlank": false,
            "multi": "paragraph,strong,em"
          }
        },
        "section_title": {
          "type": "StructuredText",
          "config": {
            "label": "Section title (optional)",
            "placeholder": "",
            "allowTargetBlank": false,
            "multi": "paragraph,strong,em"
          }
        },
        "display_mode": {
          "type": "Select",
          "config": {
            "label": "Display mode",
            "placeholder": "",
            "options": [
              "Grid",
              "Slider"
            ],
            "default_value": "Grid"
          }
        },
        "items_per_row": {
          "type": "Select",
          "config": {
            "label": "Items per row (Grid) / slides per view (Slider)",
            "placeholder": "",
            "options": [
              "1",
              "2",
              "3",
              "4"
            ],
            "default_value": "1"
          }
        },
        "gaps": {
          "type": "Select",
          "config": {
            "label": "Gaps (spacing between items & grid width)",
            "placeholder": "",
            "options": [
              "normal",
              "full-screen"
            ],
            "default_value": "normal"
          }
        },
        "item_gap": {
          "type": "Select",
          "config": {
            "label": "Space between items in a row",
            "placeholder": "",
            "options": [
              "none",
              "small",
              "normal",
              "large"
            ],
            "default_value": "normal"
          }
        },
        "slice_spacing": {
          "type": "Select",
          "config": {
            "label": "Space above and below this section",
            "placeholder": "",
            "options": [
              "none",
              "small",
              "normal",
              "large"
            ],
            "default_value": "normal"
          }
        },
        "text_size": {
          "type": "Select",
          "config": {
            "label": "Text size (captions and text blocks)",
            "placeholder": "",
            "options": [
              "small",
              "normal",
              "large"
            ],
            "default_value": "normal"
          }
        },
        "text_align": {
          "type": "Select",
          "config": {
            "label": "Text alignment (captions and text blocks)",
            "placeholder": "",
            "options": [
              "left",
              "center",
              "right"
            ],
            "default_value": "center"
          }
        },
        "items": {
          "type": "Group",
          "config": {
            "label": "Items",
            "fields": {
              "content_type": {
                "type": "Select",
                "config": {
                  "label": "Content type",
                  "placeholder": "",
                  "options": [
                    "Video",
                    "Image",
                    "Embed",
                    "Text"
                  ],
                  "default_value": "Image"
                }
              },
              "video": {
                "type": "Link",
                "config": {
                  "label": "Video file (.mp4 upload)",
                  "placeholder": "Upload or select an mp4",
                  "select": "media"
                }
              },
              "video_url": {
                "type": "Text",
                "config": {
                  "label": "Video URL (.m3u8 HLS stream or .mp4) \u2014 paste an external link; overrides the uploaded file above",
                  "placeholder": "https://\u2026/playlist.m3u8"
                }
              },
              "poster": {
                "type": "Image",
                "config": {
                  "label": "Poster / still image (Video) \u2014 when set, the grid shows this still and clicking it follows the item's Link instead of playing inline",
                  "constraint": {},
                  "thumbnails": []
                }
              },
              "image": {
                "type": "Image",
                "config": {
                  "label": "Image",
                  "constraint": {},
                  "thumbnails": []
                }
              },
              "embed": {
                "type": "Embed",
                "config": {
                  "label": "Embed (YouTube / Vimeo / SoundCloud)",
                  "placeholder": "Paste a URL"
                }
              },
              "text": {
                "type": "StructuredText",
                "config": {
                  "label": "Text",
                  "placeholder": "",
                  "allowTargetBlank": true,
                  "multi": "paragraph,preformatted,heading2,heading3,strong,em,hyperlink,list-item,o-list-item"
                }
              },
              "caption": {
                "type": "StructuredText",
                "config": {
                  "label": "Caption (Enter = new row)",
                  "placeholder": "",
                  "allowTargetBlank": false,
                  "multi": "paragraph,strong,em"
                }
              },
              "link": {
                "type": "Link",
                "config": {
                  "label": "Link (optional \u2014 makes the item clickable)",
                  "placeholder": "",
                  "allowTargetBlank": true,
                  "select": null
                }
              },
              "hover_label": {
                "type": "Text",
                "config": {
                  "label": "Hover label (optional \u2014 shown over the image on hover; defaults to the linked page's name)",
                  "placeholder": "e.g. Aquarelle"
                }
              },
              "size": {
                "type": "Select",
                "config": {
                  "label": "Size (Grid mode only)",
                  "placeholder": "",
                  "options": [
                    "small",
                    "medium",
                    "large",
                    "full-screen"
                  ],
                  "default_value": "medium"
                }
              },
              "object_fit": {
                "type": "Select",
                "config": {
                  "label": "Image fit",
                  "placeholder": "",
                  "options": [
                    "contain",
                    "cover",
                    "fill"
                  ],
                  "default_value": "contain"
                }
              },
              "image_height": {
                "type": "Select",
                "config": {
                  "label": "Image height",
                  "placeholder": "",
                  "options": [
                    "auto",
                    "300px",
                    "400px",
                    "500px",
                    "600px",
                    "700px",
                    "800px"
                  ],
                  "default_value": "auto"
                }
              }
            }
          }
        }
      },
      "items": {}
    }
  ]
}
